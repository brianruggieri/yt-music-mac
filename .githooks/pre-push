#!/bin/sh
# Local light-theme regression gate. Runs the frozen-fixture WebKit harness BEFORE a push that
# touches the engine or harness, so regressions are caught on your machine instead of burning a
# GitHub Actions macOS run per push. Mirrors light-theme-gate.yml's path filter.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Skip a single push:      git push --no-verify
#
# stdin lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
ZERO=0000000000000000000000000000000000000000
root=$(git rev-parse --show-toplevel)
GATED='youtube-music-player/(LightThemeEngine|YouTubeMusicWebView)\.swift|^harness/'

run=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                       # branch deletion — nothing to test
  if [ "$remote_sha" = "$ZERO" ]; then                          # new branch: diff against main
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "${local_sha}~1")
  else
    base="$remote_sha"
  fi
  if git diff --name-only "$base" "$local_sha" | grep -qE "$GATED"; then run=1; fi
done
[ "$run" = 0 ] && exit 0

echo "▶ Local light-theme gate — running the WebKit harness (skip with: git push --no-verify)…"
if ! ( cd "$root/harness" && npm test ); then
  echo "✗ light-theme gate failed — push aborted. Fix, or re-run with 'git push --no-verify'."
  exit 1
fi
echo "✓ light-theme gate passed."
exit 0
